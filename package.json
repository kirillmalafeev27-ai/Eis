{
  "name": "eisschollen",
  "private": true,
  "version": "0.1.0",
  "description": "«Льдины» (Die Eisschollen) — третья игра серии: переправа по льдинам за ответы на вопросы по немецкому",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "tsx tools/sim.ts",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
